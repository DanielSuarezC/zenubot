# Puerto del servidor
PORT=3000

# Modo de ejecución (development, production)
NODE_ENV=development

# URL de conexión a PostgreSQL
# Ejemplo para Supabase:
# DATABASE_URL=postgresql://usuario:password@host:5432/database?sslmode=require
# Ejemplo para PostgreSQL local:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/zenubot_chat
DATABASE_URL=

# Si la conexión requiere SSL (true/false)
DATABASE_SSL=true

# API Key para autenticación de endpoints
# Generar una clave segura: openssl rand -hex 32
API_KEY=

# Alternativa: usar CHAT_API_KEY (el código busca ambas)
CHAT_API_KEY=




